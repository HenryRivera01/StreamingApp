{
  "name": "streaming-platform-backend",
  "version": "1.0.0",
  "description": "Plataforma de streaming tipo Netflix/Jellyfin con PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:auth": "node scripts/test_auth.js",
    "etl:export:csv": "node scripts/neo4j/export_pg_to_csv.js",
    "etl:reconcile": "node scripts/neo4j/reconcile_pg_neo4j.js",
    "cutover:status": "node scripts/neo4j/cutover_flags.js status",
    "cutover:list": "node scripts/neo4j/cutover_flags.js list",
    "cutover:apply": "node scripts/neo4j/cutover_flags.js apply",
    "cutover:rollback": "node scripts/neo4j/cutover_flags.js rollback",
    "smoke:cutover": "node scripts/neo4j/smoke_cutover.js",
    "cutover:pipeline": "node scripts/neo4j/cutover_pipeline.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^6.0.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
